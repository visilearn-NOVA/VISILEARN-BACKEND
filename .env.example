# ==============================================================================
# VisiLearn Backend Environment Configuration
# Copy this file to .env and adjust the values for your local environment
# ==============================================================================

# Application Settings
PROJECT_NAME="VisiLearn: Student Performance Analytics"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="insecure-dev-secret-key-change-this-in-production-only-for-local-dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="visilearn_db"

# Optional explicit DB URL override (leave blank to construct from POSTGRES_* above)
DATABASE_URL=""

# Cross-Origin Resource Sharing (CORS)
# List of origins permitted to communicate with the API (JSON array or comma-separated)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# Machine Learning Engine Configuration
ML_MODEL_DIR="app/ml/models"
ACTIVE_MODEL_VERSION="v1.0.0"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
